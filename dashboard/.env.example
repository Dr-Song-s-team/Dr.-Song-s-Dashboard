# Copy to .env.local and fill in values. Never commit .env.local.
# Leaving a value blank fails the same way as omitting it, with a message
# naming the variable — see dashboard/lib/env.ts.

# Neon → Connect → Prisma shows two connection strings. Both go here.

# Pooled connection (host contains `-pooler`) — used by the app at runtime.
DATABASE_URL=

# Direct connection (same host, `-pooler` removed) — used by Prisma Migrate,
# which needs session state the pooler does not provide.
DIRECT_URL=

# Groq API key — server-side only, never NEXT_PUBLIC_ (get from https://console.groq.com)
GROQ_API_KEY=

# Web Push / VAPID keys for push notifications (optional - if not set, push features return 503)
# Generate with: npx web-push generate-vapid-keys
VAPID_EMAIL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
