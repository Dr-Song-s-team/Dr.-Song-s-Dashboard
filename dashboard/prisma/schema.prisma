// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url is provided via prisma.config.ts / DATABASE_URL env var
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum DocumentType {
  INTAKE_1_1
  INTAKE_1_2
  INTAKE_1_3
  SOAP_NOTE
  CMS_1500
  ASH_MNR
  PI_REPORT
}

enum DocumentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ClinicInbox {
  INFO
  BILLING
  AUTHORIZATIONS
  REFERRALS
  SCHEDULING
  CLAIMS
}

enum EmailStatus {
  UNREAD
  READ
  NEEDS_ACTION
  ARCHIVED
}

enum EmailClassification {
  AUTHORIZATION
  CLAIM
  REFERRAL
  SCHEDULING
  BILLING
  GENERAL
  UNKNOWN
}


// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Patient {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  dob         DateTime
  phone       String
  email       String   @unique
  address     String
  city        String
  state       String
  zip         String
  insurer     String
  memberId    String
  authLimit   Int
  visitsUsed  Int      @default(0)
  statusNotes String?

  // Billing profile — monetary values stored as integer cents to avoid float issues.
  copayCents             Int?
  deductibleCents        Int?
  deductibleMetCents     Int?
  paymentStatus          String?
  outstandingBalanceCents Int?
  lastPaymentDate        DateTime?
  paymentMethod          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  emails    Email[]
}

/// A form or report associated with a patient. `fixturePath` is the
/// public-folder path served by Next.js (e.g. /fixtures/documents/sample-cms-1500.pdf).
model Document {
  id          String         @id @default(cuid())
  type        DocumentType
  status      DocumentStatus @default(DRAFT)
  title       String
  fixturePath String
  notes       String?
  content     String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])
}

model GmailAccount {
  id           String   @id @default(cuid())
  emailAddress String   @unique
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  emails Email[]
}


/// A seeded inbox message received at one of the six clinic email addresses.
model Email {
  id             String              @id @default(cuid())

  // Gmail identifiers
  gmailMessageId String?             @unique
  gmailThreadId  String?

  // Which Gmail account imported this
  gmailAccountId String?
  gmailAccount   GmailAccount? @relation(fields: [gmailAccountId], references: [id])

  toInbox        ClinicInbox
  fromName       String
  fromEmail      String
  subject        String
  body           String

  status         EmailStatus         @default(UNREAD)
  classification EmailClassification @default(UNKNOWN)

  insurerLabel   String?
  aiSummary      String?
  aiDraft        String?

  // Full structured AI analysis
  aiAnalysis     Json?

  receivedAt     DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  metrics EmailMetric[]

  @@index([receivedAt])
  @@index([status])
  @@index([insurerLabel])
}

model PushSubscription {
  id String @id @default(cuid())

  endpoint String @unique
  p256dh String
  auth String

  createdAt DateTime @default(now())
}

/// Tracks a single batch run of the AI email analyzer.
/// Used to compute average analysis time and overall success/error rate.
model AnalysisBatch {
  id              String    @id @default(cuid())
  startedAt       DateTime
  completedAt     DateTime?
  durationMs      Int?
  emailsAttempted Int
  emailsSucceeded Int       @default(0)
  emailsFailed    Int       @default(0)
  success         Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([createdAt])
}

/// Staff rating for AI-generated content on a single email.
/// analysisUsefulness and koreanTranslationAccuracy are each constrained to 1–5
/// via a CHECK constraint in the database migration.
model EmailMetric {
  id                        String   @id @default(cuid())
  emailId                   String
  email                     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  analysisUsefulness        Int
  koreanTranslationAccuracy Int
  createdAt                 DateTime @default(now())

  @@index([emailId])
}

/// Represents an AI chat session with the admin assistant.
model ChatSession {
  id        String        @id @default(cuid())
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([createdAt])
}

/// Individual messages within a chat session.
model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([sessionId])
}